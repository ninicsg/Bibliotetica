<!DOCTYPE html>
<html>
<head>
  <title>Bibliotetica</title>
  <%= stylesheet_link_tag 'application', media: 'all' %>
  <%= javascript_include_tag "application" %>
  <%= csrf_meta_tags %>
</head>
<body>

  <% if flash[:notice] %>
    <div></div>
    <div class="flash notice">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <% if flash[:alert] %>
    <div></div>
    <div class="flash alert">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%= yield %>

</body>
</html>
