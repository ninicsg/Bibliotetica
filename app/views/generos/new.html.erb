<div class="form">
  <h1>Novo Gênero</h1>

    <%= form_for @genero, url: create_genero_path do |f| %>    <% if @genero.errors.any? %>
      <div class="errors">
        <ul>
          <% @genero.errors.full_messages.each do |erro| %>
            <li><%= erro %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-caixa">
      <div class="campo">
        <%= f.label :nome, "Nome do Gênero" %>
        <%= f.text_field :nome %>
      </div>

      <div class="acao">
        <%= f.submit "Salvar Gênero", class: "btn-primeiro" %>
        <%= link_to "Cancelar", generos_path, class: "btn-primeiro" %>
      </div>
    </div>
  <% end %>
</div>