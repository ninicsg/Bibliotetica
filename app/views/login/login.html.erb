<div class="login">
    <h1 class="first">
        Login
    </h1>

    <%= form_tag logar_path do %>
        <%= label_tag :login, "Login" %>
        <%= text_field_tag :login %>
        <%= link_to "Criar novo usuário", new_usuario_path, class: "criar" %>
        <br>
        <%= label_tag  :senha, "Senha"%>
        <%= password_field_tag :senha %>

        <%= submit_tag "Enviar" %>
    <% end %>
</div>