<div class="show">
  <div class="h1q">
    <h1>Minha Biblioteca</h1>

    <div class="aham">
      <p><strong>ID:</strong> <%= @usuario.id %></p>
      <p><strong>Usuário:</strong> <%= @usuario.username %></p>
      <p><strong>E-mail:</strong> <%= @usuario.email %></p>

      <hr>

      <h2 class="acoes-livro">📖Empréstimos Ativos</h2>

      <% if @emprestimos_ativos.any? %>
        <ul>
          <% @emprestimos_ativos.each do |e| %>
            <li>
              <% if e.livro %>
                <strong><%= e.livro.titulo %></strong>
              <% else %>
                <strong style="color:red;">Livro removido</strong>
              <% end %>
              <br>

              <% if e.livro %>
                <div class="acoes-livro">
                  Devolver até:
                  <span style="color:<%= e.atrasado? ? 'red' : 'green' %>;">
                    <%= e.data_prevista_devolucao.strftime("%d/%m/%Y") %>
                  </span>
                </div>

                <%= link_to "Ver Livro",
                      livro_path(e.livro),
                      class: "btn-primeiro" %>
                <%= link_to "Devolver",
                      devolver_livro_path(e.livro),
                      method: :post,
                      class: "btn-segundo" %>
              <% end %>
            </li>
            <br>
          <% end %>
        </ul>
      <% else %>
        <p>Nenhum empréstimo ativo.</p>
      <% end %>

      <% if @emprestimos_atrasados.any? %>
        <hr>
        <h2 style="color:red;">⏰Empréstimos Atrasados</h2>
        <p>
          Você possui <strong><%= @emprestimos_atrasados.count %></strong>
          empréstimo(s) em atraso.
        </p>
      <% end %>

      <hr>

      <h2>⌛Minhas Reservas</h2>

      <% if @reservas.any? %>
        <ul>
          <% @reservas.each do |r| %>
            <li>
              <% if r.livro %>
                <strong><%= r.livro.titulo %></strong>
                <br>
                Posição na fila:
                <strong><%= r.posicao %></strong>

                <%= link_to "Ver Livro",
                      livro_path(r.livro),
                      class: "btn-primeiro" %>
              <% else %>
                <strong style="color:red;">Livro removido</strong>
              <% end %>
            </li>
            <br>
          <% end %>
        </ul>
      <% else %>
        <p>Você não possui reservas.</p>
      <% end %>

      <hr>

      <%= link_to "Voltar", home_path, class: "btn-primeiro" %>
    </div>
  </div>
</div>
