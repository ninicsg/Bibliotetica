<h1>Autores</h1>

<%= link_to "Novo autor", new_autor_path, class: "btn-new" %>

<% if @autores.present? %>

  <table class="tabela">
    <thead>
      <tr>
        <th>ID</th>
        <th>Nome</th>
        <th>Data de nascimento</th>
        <th>Data de óbito</th>
        <th>Editar</th>
        <th>Excluir</th>
        <th></th>
      </tr>
    </thead>

    <tbody>
      <% @autor.each do |autor| %>
        <tr>
          <td><%= autor.id %></td>

          <td>
            <%= link_to autor.nome, autor_path(autor) %>
          </td>
          <td>

          <td>
            <%= link_to "Editar",
              edit_autor_path(autor),
              class: "btn-edit" %>
          </td>

          <td>
            <%= link_to "Excluir",
              autor_path(autor),
              method: :delete,
              data: { confirm: "Tem certeza?" },
              class: "btn-delete" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

<% else %>
    <p>
        Não existem autores cadastrados
    <p>
<% end %>
