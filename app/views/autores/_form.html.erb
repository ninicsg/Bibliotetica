<h1>Autor</h1>

<%= form_for @autor, url: @autor.new_record? ? criar_autor_path : atualizar_autor_path(@autor), method: @autor.new_record? ? :post : :put do |f| %>

  <% if @autor.errors.any? %>
    <div class="errors">
      <h3>Erro ao salvar:</h3>
      <ul>
        <% @autor.errors.full_messages.each do |erro| %>
          <li><%= erro %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-caixa">

    <div class="campo">
      <%= f.label :nome, "Nome" %>
      <%= f.text_field :nome %>
    </div>

    <div class="campo">
      <%= f.label :data_nasc, "Data de nascimento" %>
      <%= f.text_field :data_nasc %>
    </div>

    <div class="campo">
      <%= f.label :data_morte, "Data de óbito" %>
      <%= f.text_field :data_morte %>
    </div>

    <div class="acao">
      <%= f.submit "Salvar", class: "btn-primeiro" %>
      <%= link_to "Cancelar", autores_path, class: "btn-primeiro" %>
    </div>

  </div>

<% end %>